# Mock mode: the web app runs on fixtures with no keys and no registrar service.
# Copy to .env.local (or .env.development.local) and adjust. No secrets here.
API_MOCKING=enabled
NEXT_PUBLIC_API_MOCKING=enabled
# Real registrar (make api) — used only when API_MOCKING=disabled.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
