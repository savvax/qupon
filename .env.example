# Copy to .env (git-ignored). Devnet only. Never put mainnet keys here.
RPC_URL=https://devnet.helius-rpc.com/?api-key=REPLACE_ME
HELIUS_API_KEY=REPLACE_ME
SOLANA_CLUSTER=devnet

# Keypairs (JSON files created by ops/wallets.sh; paths only)
QUPON_REGISTRAR_KEYPAIR=$HOME/.config/qupon/registrar.json
QUPON_ISSUER_KEYPAIR=$HOME/.config/qupon/issuer.json
QUPON_PAYING_AGENT_KEYPAIR=$HOME/.config/qupon/paying-agent.json
QUPON_INVESTOR1_KEYPAIR=$HOME/.config/qupon/investor1.json
QUPON_INVESTOR2_KEYPAIR=$HOME/.config/qupon/investor2.json
QUPON_INVESTOR3_KEYPAIR=$HOME/.config/qupon/investor3.json
QUPON_OUTSIDER_KEYPAIR=$HOME/.config/qupon/outsider.json

# Agents
ZAI_API_KEY=REPLACE_ME            # pi provider "zai" (GLM-5.3 / GLM-5.3-Flash)
# CLAUDE_CODE_OAUTH_TOKEN=        # only for a headless box: `claude setup-token` on your laptop
AUTO_PUSH=0                       # 1 = orchestrator pushes main to origin after each merge
FORCE_PEAK=0                      # 1 = run GLM-5.3 tasks even during Z.ai peak hours (Mon–Fri 11:00–15:00 Astana)
CLAUDE_WORKER_MODEL=opus
CLAUDE_REVIEW_MODEL=sonnet
CLAUDE_BYPASS=0                   # 1 = add --dangerously-skip-permissions to Claude runs (ONLY inside ops/Dockerfile or a VM)
