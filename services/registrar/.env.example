# Registrar service environment (see internal/config/config.go).
# ops/deploy-vps.sh writes the real values to /opt/qupon/registrar.env on the server (mode 600), never into git.

PORT=8080
DB_PATH=/data/registrar.db

# Solana devnet
RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=QPN1zdVm6PgMdJo4YxemtDxxbUczqaAk9sDsJQsJ2qd

# qupon CLI executor (advance endpoint)
QUPON_CLI=qupon
QUPON_CONFIG=/app/config/devnet.json

# One-click demo sign-in (POST /auth/demo) and the three demo users. 1 on the public demo deployment.
DEMO_LOGIN=1
# Back-office accounts upserted at startup: JSON [{"email","name","role":"issuer|registrar|admin","password"}].
# Passwords of 12+ characters; keep this out of git.
QUPON_USERS=

# Operator keypairs for the executor (devnet only), as the keypair file's JSON array. entrypoint.sh writes them to
# /run/qupon/<role>.json (0600, service user) and sets QUPON_<ROLE>_KEYPAIR. Set with:
QUPON_REGISTRAR_KEYPAIR_JSON=
QUPON_ISSUER_KEYPAIR_JSON=
QUPON_PAYING_AGENT_KEYPAIR_JSON=
QUPON_KYC_PROVIDER_KEYPAIR_JSON=
# Demo investor's custodial wallet (POST /demo/investor/subscribe and /vote).
QUPON_INVESTOR_KEYPAIR_JSON=
# Optional: a keyed devnet RPC for the executor's transactions (server-side secret, never NEXT_PUBLIC_).
# RPC_URL=
