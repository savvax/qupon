# Registrar service environment (see internal/config/config.go).
# Copy the real values into Fly secrets (`fly secrets set …`), never into git.

PORT=8080
DB_PATH=/data/registrar.db

# Solana devnet
RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=QPN1zdVm6PgMdJo4YxemtDxxbUczqaAk9sDsJQsJ2qd

# qupon CLI executor (advance endpoint)
QUPON_CLI=qupon
QUPON_CONFIG=/data/config/devnet.json

# Bearer token required on POST /actions/{pda}/advance when set.
ADVANCE_TOKEN=
